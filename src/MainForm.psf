$checkedlistboxListOfManagedIdentity_ItemCheck = [System.Windows.Forms.ItemCheckEventHandler]{
	
	param (
		[System.Object]$sender,
		[System.Windows.Forms.ItemCheckEventArgs]$e
	)
	
	# Uncheck all other items
	for ($i = 0; $i -lt $checkedlistboxListOfManagedIdentity.Items.Count; $i++)
	{
		if ($i -ne $e.Index)
		{
			$checkedlistboxListOfManagedIdentity.SetItemChecked($i, $false)
		}
	}
	
	# Update the selected identity details
	if ($e.NewValue -eq [System.Windows.Forms.CheckState]::Checked)
	{
		# Uddate data
		Update-SelectedIdentity -selectedIndex $e.Index
	}
	else
	{
		# Reset form
		$textboxselectedIdentityID.Clear()
		$textboxselectedIdentityName.Clear()
		$textboxAssingedRoles.Clear()
	}
}

$csvToolStripMenuItem_Click = {
	if (-not $global:ConnectedState)
	{
		Show-MsgBox -Title "Not connected" -Prompt "Connect to Microsoft Graph before importing permissions from CSV." -Icon Exclamation -BoxType OKOnly
		Write-Log -Level WARNING -Message "Import from CSV was requested without an active Graph connection."
		return
	}
	
	$openFileDialog = New-Object System.Windows.Forms.OpenFileDialog
	$openFileDialog.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*"
	$openFileDialog.Title = "Import Permissions from CSV"
	$openFileDialog.Multiselect = $false
	
	if ($openFileDialog.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK)
	{
		Write-Log -Level INFO -Message "Import from CSV was canceled by the user before file selection."
		return
	}
	
	$importFilePath = $openFileDialog.FileName
	$importMode = Show-MsgBox -Prompt "How do you want to import permissions from the selected file?`r`n`r`nYes = Reset existing permissions first (for each Managed Identity in file).`r`nNo = Keep existing permissions and only add missing ones.`r`nCancel = Stop import." -Title "Select import mode" -Icon Question -BoxType YesNoCancel -DefaultButton 2
	
	if ($importMode -eq "Cancel")
	{
		Write-Log -Level INFO -Message "Import from CSV was canceled by the user on import mode selection."
		return
	}
	
	$clearExistingPermissionsForImport = $false
	if ($importMode -eq "Yes")
	{
		$clearExistingPermissionsForImport = $true
	}
	
	try
	{
		$importSummary = Import-ManagedIdentityPermissions -ImportFilePath $importFilePath -ClearExistingPermissions $clearExistingPermissionsForImport
		
		Show-MsgBox -Title "Import completed" -Prompt "Import completed from file:`r`n`r`n$importFilePath`r`n`r`nRows read: $($importSummary.RowsRead)`r`nRows processed: $($importSummary.RowsProcessed)`r`nManaged Identities processed: $($importSummary.IdentitiesProcessed)`r`nServices processed: $($importSummary.ServicesProcessed)`r`nPermissions attempted: $($importSummary.PermissionsAttempted)`r`nSkipped rows: $($importSummary.SkippedRows)" -Icon Information -BoxType OKOnly
	}
	catch
	{
		$errorMessage = "Import failed: $($_.Exception.Message)"
		Write-Log -Level ERROR -Message $errorMessage
		Show-MsgBox -Title "Import failed" -Prompt $errorMessage -Icon Critical -BoxType OKOnly
	}
}

